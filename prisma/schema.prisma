generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id           String             @id @default(cuid())
  title        String
  fileName     String
  content      String             @db.Text
  fingerprints Json               @default("[]")
  createdAt    DateTime           @default(now())
  
  // Relations for similarity
  similarAsA   SimilarityResult[] @relation("DocumentA")
  similarAsB   SimilarityResult[] @relation("DocumentB")
}

model SimilarityResult {
  id              String   @id @default(cuid())
  documentAId     String
  documentBId     String
  similarityScore Float    // 0-100
  matchedRangesA  Json     @default("[]") // Array of tuple [startOrig, endOrig]
  matchedRangesB  Json     @default("[]") // Array of tuple [startOrig, endOrig]
  createdAt       DateTime @default(now())

  documentA Document @relation("DocumentA", fields: [documentAId], references: [id], onDelete: Cascade)
  documentB Document @relation("DocumentB", fields: [documentBId], references: [id], onDelete: Cascade)

  @@unique([documentAId, documentBId])
}
